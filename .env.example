# Sao chép thành .env và điền giá trị thật. .env đã được gitignore — KHÔNG commit key thật (ER-007).

# --- Jev API (TypeSafe) — dùng cho Pipeline B ---
# API key của dịch vụ Jev (cung cấp qua Secure Vault, xem Q2 trong spec).
JEV_API_KEY=
# Địa chỉ gốc của Jev API.
JEV_API_BASE=

# --- LLM generation / scorer model nhỏ — dùng cho Pipeline A/C và chấm ở Pipeline C ---
# API key của LLM qua AI Gateway (endpoint tương thích OpenAI).
LLM_API_KEY=
# Địa chỉ gốc của AI Gateway, ví dụ https://<gateway>/v1
LLM_API_BASE=
# Tên model LLM, ví dụ model nhỏ dùng làm scorer cho Pipeline C.
LLM_MODEL=

# --- Embedding qua HTTP (tùy chọn — mặc định dùng HashingEmbedder local, không cần 3 biến này) ---
# API key của dịch vụ embedding.
EMBEDDING_API_KEY=
# Địa chỉ gốc của endpoint embedding tương thích OpenAI.
EMBEDDING_API_BASE=
# Tên model embedding.
EMBEDDING_MODEL=
